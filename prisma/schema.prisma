// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum ToolType {
  BLOG_GENERATOR
  INSTAGRAM_CAPTION
  PRODUCT_DESCRIPTION
  YOUTUBE_DESCRIPTION
  YOUTUBE_SCRIPT
  CODE_ASSISTANT
  AI_CHAT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  credits       Int       @default(10)
  apiKey        String?   @unique @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  generatedContent GeneratedContent[]
  subscriptions Subscription[]
  usageLogs     UsageLog[]
  transactions  Transaction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model GeneratedContent {
  id        String   @id @default(cuid())
  userId    String
  toolType  ToolType
  title     String
  input     Json
  output    String
  isSaved   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([toolType])
  @@map("generated_content")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  ctaText     String?
  ctaLink     String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  plan               Plan
  status             String   @default("active")
  stripeCustomerId   String?
  stripeSubId        String?
  razorpaySubId      String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  toolType  ToolType
  credits   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("usage_logs")
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  plan        Plan     @unique
  price       Float
  currency    String   @default("USD")
  credits     Int
  features    Json
  isPopular   Boolean  @default(false)
  stripePriceId String?
  razorpayPlanId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pricing_plans")
}

model Prompt {
  id          String   @id @default(cuid())
  toolType    ToolType @unique
  name        String
  description String?
  template    String
  variables   Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompts")
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String
  amount          Float
  currency        String   @default("USD")
  status          String   @default("pending")
  type            String
  paymentMethod   String?
  stripePaymentId String?
  razorpayPaymentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

model SystemSettings {
  id                      String   @id @default("default")
  appName                 String   @default("Spray Scribe")
  appLogo                 String?
  openaiKey               String?
  anthropicKey            String?
  rateLimitPerHour        Int      @default(100)
  creditCostPerGeneration Int      @default(5)
  maintenanceMode         Boolean  @default(false)
  allowSignups            Boolean  @default(true)
  emailNotifications      Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("system_settings")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  // null = broadcast to all users
  title     String
  message   String
  type      String   @default("info") // info | success | warning | error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @default("percent") // percent | flat_credits
  discountValue Float     // percent: 0-100, flat_credits: number of bonus credits
  maxUses       Int?      // null = unlimited
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  redemptions   CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  createdAt DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId]) // one redemption per user per coupon
  @@index([userId])
  @@map("coupon_redemptions")
}

model PromoBanner {
  id          String   @id @default(cuid())
  message     String
  linkText    String?
  linkHref    String?
  color       String   @default("teal") // teal | amber | rose | sky
  isActive    Boolean  @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("promo_banners")
}
